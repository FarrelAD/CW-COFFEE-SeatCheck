{
	"compilerOptions": {
		"target": "ES2017",
		"lib": [
			"ES2017",
			"DOM"
		],
		"types": [
			"cypress",
			"node"
		],
		"moduleResolution": "node",
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"strict": true,
		"skipLibCheck": true,
		"baseUrl": "../",
		"paths": {
			"@/*": [
				"./*"
			]
		}
	},
	"include": [
		"**/*.ts",
		"**/*.tsx"
	],
	"exclude": [
		"node_modules"
	]
}