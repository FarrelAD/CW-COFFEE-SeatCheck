{
	"rules": {
		"outlets": {
			"$outletId": {
				"zones": {
					"$zoneName": {
						"seats": {
							".read": true,
							".write": "auth != null",
							"$seatId": {
								".write": true,
								".validate": "newData.hasChildren(['type', 'status', 'updatedAt'])",
								"type": {
									".validate": "newData.isString() && (newData.val() == 'chair' || newData.val() == 'table' || newData.val() == 'walkway')"
								},
								"status": {
									".validate": "newData.isString() && (newData.val() == 'available' || newData.val() == 'used' || newData.val() == 'reserved')"
								},
								"face": {
									".validate": "newData.isString() && (newData.val() == 'up' || newData.val() == 'down' || newData.val() == 'left' || newData.val() == 'right')"
								},
								"updatedAt": {
									".validate": "newData.isNumber()"
								},
								"checkedInAt": {
									".validate": "newData.isNumber()"
								},
								"sessionId": {
									".validate": "newData.isString()"
								}
							}
						},
						"capacity": {
							".read": true,
							".write": "auth != null",
							".validate": "newData.hasChildren(['total', 'used', 'available'])",
							"total": {
								".validate": "newData.isNumber() && newData.val() >= 0"
							},
							"used": {
								".validate": "newData.isNumber() && newData.val() >= 0"
							},
							"available": {
								".validate": "newData.isNumber() && newData.val() >= 0"
							}
						}
					}
				},
				"checkins": {
					".read": true,
					".write": true,
					"$sessionId": {
						".validate": "newData.hasChildren(['seatId', 'zone', 'outletId', 'checkedInAt', 'sessionId'])",
						"seatId": {
							".validate": "newData.isString()"
						},
						"zone": {
							".validate": "newData.isString()"
						},
						"outletId": {
							".validate": "newData.isNumber()"
						},
						"checkedInAt": {
							".validate": "newData.isNumber()"
						},
						"checkedOutAt": {
							".validate": "newData.isNumber() || newData.val() == null"
						},
						"duration": {
							".validate": "newData.isNumber() || newData.val() == null"
						},
						"sessionId": {
							".validate": "newData.isString()"
						}
					}
				}
			}
		}
	}
}